# Environment Configuration
APP_ENV=development
HOST=0.0.0.0
PORT=8000
DEBUG=true

# CORS (comma-separated or JSON list)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# OCR Binary Path (Optional override if not in PATH)
TESSERACT_CMD=

# External LLM Configuration
LLM_PROVIDER=openai-compatible
LLM_API_KEY=
LLM_BASE_URL=https://exo.manysphere.info/v1
LLM_MODEL=mlx-community/Qwen3.6-35B-A3B-4bit
